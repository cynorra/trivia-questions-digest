# Copy to .env for local work. Never commit .env.

# Build-time read access: just the project id. firestore.rules let anyone read
# published articles and nothing else, so the build needs no key.
FIREBASE_PROJECT_ID=

# Write access (service account JSON on one line). Only for the pipeline and
# scripts/push-guides.mjs. Bypasses the rules: never give it to the site build,
# Cloudflare or any client code; in GitHub only in the auto-blog job.
FIREBASE_SERVICE_ACCOUNT=

# Gemini, for scripts/pipeline (comma-separate several keys).
GEMINI_API_KEY=
