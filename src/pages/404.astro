---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page does not exist. Try today's trivia quiz, the trivia questions by category or the fun facts." noindex>
  <div class="mx-auto max-w-6xl px-4 py-16">
    <p class="num text-brand text-sm font-semibold">404</p>
    <h1 class="mt-2 text-3xl md:text-4xl font-extrabold">That page isn't here.</h1>
    <p class="mt-3 text-muted-foreground max-w-[55ch]">The link may be old or mistyped. Try one of these:</p>
    <ul class="mt-6 grid gap-2 max-w-xl">
      <li><a href="/daily-trivia/">Daily trivia</a></li>
      <li><a href="/general-knowledge-trivia/">General knowledge trivia</a></li>
      <li><a href="/fun-facts/">Fun facts</a></li>
      <li><a href="/map-quizzes/">Map quizzes</a></li>
      <li><a href="/guides/">Guides</a></li>
    </ul>
  </div>
</Base>
