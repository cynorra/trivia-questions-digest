---
// One route for map/flag quizzes and country fact pages.
import GeoPage from "../components/geo/GeoPage.astro";
import CountryFactsPage from "../components/trivia/CountryFactsPage.astro";
import { COUNTRY_PAGES } from "../lib/trivia/country-facts.js";
import { PAGES as GEO_PAGES } from "../lib/geo/pages.js";

export function getStaticPaths() {
  const slugs = [...GEO_PAGES.map((p) => p.slug), ...COUNTRY_PAGES.map((c) => c.slug)];
  if (new Set(slugs).size !== slugs.length) throw new Error("Two pages share a slug");
  return [
    ...GEO_PAGES.map((page) => ({ params: { slug: page.slug }, props: { page } })),
    ...COUNTRY_PAGES.map((country) => ({ params: { slug: country.slug }, props: { country } })),
  ];
}
const { page, country } = Astro.props;
---
{country ? <CountryFactsPage country={country} /> : <GeoPage page={page} />}
