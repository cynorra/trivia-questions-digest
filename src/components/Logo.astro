---
// A speech bubble with a question mark: one question a day.
interface Props { size?: number }
const { size = 26 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <path d="M6 4 H26 a3 3 0 0 1 3 3 V20 a3 3 0 0 1 -3 3 H14 L8 28.5 V23 H6 a3 3 0 0 1 -3 -3 V7 a3 3 0 0 1 3 -3 z" fill="var(--brand)" />
  <path d="M12.6 10.6 a3.4 3.4 0 1 1 5.2 2.9 c-1.2 .8 -1.8 1.4 -1.8 2.8" fill="none" stroke="var(--background)" stroke-width="2.4" stroke-linecap="round" />
  <circle cx="16" cy="19.2" r="1.45" fill="var(--background)" />
</svg>
